# Copy to .env and adjust.
DATABASE_URL=postgresql+psycopg://imgsvc:imgsvc@localhost:5432/imgsvc
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
MAX_DIMENSION=10000
MAX_IMAGE_PIXELS=50000000

# Optional Redis for the ?format=/?quality= conversion cache and the transform rate limits
# (both off while REDIS_URL is empty). Start one with: docker compose up -d redis
# REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=0.25
CACHE_TTL_SECONDS=86400
CACHE_MAX_ITEM_BYTES=5242880

# Per-user limits on POST /images/{id}/transform (enforced only when REDIS_URL is set;
# 0 turns a limit off).
TRANSFORM_RATE_LIMIT_PER_MINUTE=30
TRANSFORM_RATE_LIMIT_PER_HOUR=500
