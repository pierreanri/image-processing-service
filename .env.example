# Copy to .env and adjust.
DATABASE_URL=postgresql+psycopg://imgsvc:imgsvc@localhost:5432/imgsvc
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Where image files are stored: local (STORAGE_DIR) or s3 (an S3-compatible bucket).
STORAGE_BACKEND=local
STORAGE_DIR=./storage
# For STORAGE_BACKEND=s3. Leave S3_ENDPOINT_URL empty for AWS; empty region and keys use boto3's
# defaults (AWS_* variables, ~/.aws, instance or task roles). Values for the compose SeaweedFS
# (docker compose --profile s3 up -d s3):
# S3_BUCKET=imgsvc
# S3_ENDPOINT_URL=http://localhost:8333
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=imgsvc
# S3_SECRET_ACCESS_KEY=imgsvc-dev-secret
# With docker compose, STORAGE_BACKEND=s3 also needs the s3 profile:
# COMPOSE_PROFILES=s3

MAX_UPLOAD_BYTES=10485760
MAX_DIMENSION=10000
MAX_IMAGE_PIXELS=50000000

# Optional Redis for the ?format=/?quality= conversion cache and the transform rate limits
# (both off while REDIS_URL is empty). Start one with: docker compose up -d redis
# REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=0.25
CACHE_TTL_SECONDS=86400
CACHE_MAX_ITEM_BYTES=5242880

# Per-user limits on POST /images/{id}/transform (enforced only when REDIS_URL is set;
# 0 turns a limit off).
TRANSFORM_RATE_LIMIT_PER_MINUTE=30
TRANSFORM_RATE_LIMIT_PER_HOUR=500

# Background transformations (POST /images/{id}/transform with Prefer: respond-async), run by
# python -m app.worker. A run longer than the lease is discarded and the job taken over.
JOB_POLL_SECONDS=1.0
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3
JOB_RETENTION_DAYS=7
